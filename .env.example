# ========================================================
# Terminal Music Player Configuration
# ========================================================

# Custom directory containing audio files (default: ./music)
# MUSIC_DIR=/path/to/your/music

# Custom path to VLC binary if not installed in default locations:
# macOS default:   /Applications/VLC.app/Contents/MacOS/VLC
# Linux default:   /usr/bin/vlc or /usr/local/bin/vlc
# Windows default: C:\Program Files\VideoLAN\VLC\vlc.exe
# VLC_PATH=/opt/homebrew/bin/vlc

# Optional file path to debug raw VLC commands & responses:
# VLC_DEBUG=./vlc-debug.log
